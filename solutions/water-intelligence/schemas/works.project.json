{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "works.project",
  "type": "object",
  "x-kind": "entity",
  "x-version": "0.1.0",
  "x-subject": "works-project",
  "description": "A PMS capital-work project header: status, physical progress %, sanctioned/awarded cost, and the engineering division hierarchy. Thin by design (NOT a procurement work_order); work_code optionally links to the works.* procurement ledger if that data arrives. Agency/zone/division are data values.",
  "properties": {
    "id": { "type": "string", "pattern": "^ds:[a-z0-9-]+:\\S+$" },
    "schema": { "const": "works.project" },
    "tenant": { "type": ["string", "null"] },
    "project_code": { "type": "string", "description": "Source project code (e.g. PIMS projectId 'PRJ-APP-...') — the primary key." },
    "source_id": { "type": ["string", "null"], "description": "Source internal numeric id (opaque)." },
    "project_name": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"], "description": "PLANNING / IN_PROGRESS / COMPLETED (source string, not enum)." },
    "physical_progress_pct": { "type": ["number", "null"], "description": "0-100." },
    "estimated_cost": { "type": ["number", "null"] },
    "awarded_cost": { "type": ["number", "null"] },
    "cost_unit": { "type": ["string", "null"], "description": "Explicit source unit, e.g. INR_crore." },
    "zone": { "type": ["string", "null"] },
    "division": { "type": ["string", "null"] },
    "ward": { "type": ["string", "null"] },
    "jurisdiction_ref": { "type": ["string", "null"] },
    "chief_engineer": { "type": ["string", "null"] },
    "concerned_se": { "type": ["string", "null"] },
    "work_code": { "type": ["string", "null"], "description": "OPTIONAL link to works.work_order (future procurement join)." },
    "centroid": { "type": ["array", "null"], "items": { "type": "number" }, "description": "[longitude, latitude] (derived)." },
    "h3": { "type": ["string", "null"] },
    "geo_method": { "type": ["string", "null"] },
    "active": { "type": ["boolean", "null"] },
    "source": { "type": ["string", "null"] },
    "observed_at": { "type": ["string", "null"] },
    "prov": { "type": ["object", "null"] },
    "confidence": { "type": ["number", "null"] },
    "ext": { "type": ["object", "null"] }
  },
  "required": ["schema", "id", "project_code"],
  "additionalProperties": true
}
