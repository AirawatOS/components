{
 "mutation": {
  "label": "Mutation / name transfer",
  "about": "Change the recorded holder of a property after a sale, inheritance or gift; updates the department's record.",
  "offering": {
   "tenant": "city-da",
   "service_id": "new-name-transfer",
   "domain": "urban",
   "title": "Name transfer",
   "description": "Record a property holder in the new holder's name after a sale, inheritance, gift or family settlement. Look the property up by its Unified Property ID; the application goes to the zone office of the property.",
   "interaction": [
    "search",
    "select",
    "init",
    "status"
   ],
   "jurisdiction": "demo-city",
   "audience": "civic.resident",
   "solution": "ds:airawatdeveloper:solution/declarative-service",
   "required_credentials": [
    "credential.identity_verified"
   ],
   "scope_map": {
    "area": "zone"
   },
   "fulfillment": {
    "fee_service": "name-transfer",
    "payment": "before_submit",
    "documents": [
     {
      "type": "ownership-proof",
      "when": {}
     },
     {
      "type": "sale-deed",
      "when": {
       "transfer_reason": "sale"
      }
     },
     {
      "type": "death-certificate",
      "when": {
       "transfer_reason": "inheritance"
      }
     },
     {
      "type": "succession-certificate",
      "when": {
       "transfer_reason": "inheritance"
      }
     },
     {
      "type": "affidavit",
      "when": {
       "transfer_reason": [
        "gift",
        "family-settlement"
       ]
      }
     },
     {
      "type": "no-dues",
      "when": {}
     }
    ],
    "sla_hours": {
     "scrutiny": 72,
     "approval": 48
    },
    "escalate_to": "urban.commissioner",
    "workflow": [
     {
      "step": "scrutiny",
      "role": "urban.dealing-assistant",
      "office_by": "zone",
      "task": "Check the application, the documents and the dues. Forward, return for documents, or reject."
     },
     {
      "step": "approval",
      "role": "urban.estate-officer",
      "task": "Approve the transfer. The holder record is updated and the order is issued.",
      "issues": "credential.urban_name_transfer",
      "effects": [
       {
        "close": {
         "schema": "urban.property_holding",
         "match": {
          "property": "$form.property"
         },
         "patch": {
          "until": "$today"
         }
        }
       },
       {
        "write": {
         "schema": "urban.property_holding",
         "property": "$form.property",
         "holder_name": "$form.transferee_name",
         "holder_ref": "$applicant",
         "relation": "owner",
         "share_pct": 100,
         "since": "$today",
         "source_doc": "$case"
        }
       }
      ]
     }
    ]
   },
   "request_schema": {
    "type": "object",
    "required": [
     "property",
     "transfer_reason",
     "transferor_name",
     "transferee_name"
    ],
    "properties": {
     "property": {
      "type": "string",
      "title": "Unified Property ID",
      "x-section": "Property",
      "x-lookup": "urban.property",
      "description": "Printed on your allotment letter, lease deed or tax receipt."
     },
     "property_id": {
      "type": "string",
      "x-from": "property.property_id"
     },
     "zone": {
      "type": "string",
      "x-from": "property.zone"
     },
     "address": {
      "type": "string",
      "x-from": "property.address"
     },
     "land_use": {
      "type": "string",
      "x-from": "property.land_use"
     },
     "area_sqm": {
      "type": "string",
      "x-from": "property.area_sqm"
     },
     "transfer_reason": {
      "type": "string",
      "title": "Reason for transfer",
      "x-section": "Transfer",
      "enum": [
       "sale",
       "inheritance",
       "gift",
       "family-settlement"
      ]
     },
     "transferor_name": {
      "type": "string",
      "title": "Present holder (as recorded)"
     },
     "relation_to_transferor": {
      "type": "string",
      "title": "Your relation to the deceased holder",
      "enum": [
       "spouse",
       "son",
       "daughter",
       "parent",
       "other-legal-heir"
      ],
      "x-show-if": {
       "transfer_reason": "inheritance"
      }
     },
     "transferee_name": {
      "type": "string",
      "title": "New holder (your name)",
      "x-prefill": "identity.name",
      "description": "As on your verified identity."
     },
     "deed_no": {
      "type": "string",
      "title": "Registered deed number",
      "x-show-if": {
       "transfer_reason": [
        "sale",
        "gift",
        "family-settlement"
       ]
      }
     },
     "deed_date": {
      "type": "string",
      "title": "Deed date",
      "format": "date",
      "x-show-if": {
       "transfer_reason": [
        "sale",
        "gift",
        "family-settlement"
       ]
      }
     },
     "remarks": {
      "type": "string",
      "title": "Anything the office should know",
      "x-widget": "textarea",
      "x-section": "Other"
     }
    },
    "x-order": [
     "property",
     "property_id",
     "zone",
     "address",
     "land_use",
     "area_sqm",
     "transfer_reason",
     "transferor_name",
     "relation_to_transferor",
     "transferee_name",
     "deed_no",
     "deed_date",
     "remarks"
    ]
   },
   "fee_ref": "urban.fee_schedule",
   "sla_ref": "scrutiny 72h, approval 48h"
  }
 },
 "conversion": {
  "label": "Conversion (leasehold → freehold)",
  "about": "Convert tenure; on approval the property becomes freehold and the lease is marked converted.",
  "offering": {
   "tenant": "city-da",
   "service_id": "new-freehold-conversion",
   "domain": "urban",
   "title": "Freehold conversion",
   "description": "Convert a leasehold property to freehold. Look the property up, give the reason and attach the lease deed and no-dues; the conversion charge is paid online. On approval the property becomes freehold.",
   "interaction": [
    "search",
    "select",
    "init",
    "status"
   ],
   "jurisdiction": "demo-city",
   "audience": "civic.resident",
   "solution": "ds:airawatdeveloper:solution/declarative-service",
   "required_credentials": [
    "credential.identity_verified"
   ],
   "scope_map": {
    "area": "zone"
   },
   "fulfillment": {
    "fee_service": "freehold-conversion",
    "payment": "before_submit",
    "documents": [
     {
      "type": "lease-deed",
      "when": {}
     },
     {
      "type": "no-dues",
      "when": {}
     }
    ],
    "sla_hours": {
     "scrutiny": 72,
     "approval": 48
    },
    "escalate_to": "urban.commissioner",
    "workflow": [
     {
      "step": "scrutiny",
      "role": "urban.dealing-assistant",
      "office_by": "zone",
      "task": "Check the lease, dues and documents."
     },
     {
      "step": "approval",
      "role": "urban.estate-officer",
      "task": "Approve the conversion; the order is issued and the property becomes freehold.",
      "issues": "credential.urban_freehold_conversion",
      "effects": [
       {
        "close": {
         "schema": "urban.property",
         "match": {
          "id": "$form.property"
         },
         "patch": {
          "tenure": "freehold"
         }
        }
       },
       {
        "close": {
         "schema": "urban.lease",
         "match": {
          "property": "$form.property",
          "status": "active"
         },
         "patch": {
          "status": "converted"
         }
        }
       }
      ]
     }
    ]
   },
   "request_schema": {
    "type": "object",
    "required": [
     "property",
     "conversion_reason"
    ],
    "properties": {
     "property": {
      "type": "string",
      "title": "Unified Property ID",
      "x-section": "Property",
      "x-lookup": "urban.property",
      "description": "Printed on your allotment letter, lease deed or tax receipt."
     },
     "property_id": {
      "type": "string",
      "x-from": "property.property_id"
     },
     "zone": {
      "type": "string",
      "x-from": "property.zone"
     },
     "address": {
      "type": "string",
      "x-from": "property.address"
     },
     "land_use": {
      "type": "string",
      "x-from": "property.land_use"
     },
     "area_sqm": {
      "type": "string",
      "x-from": "property.area_sqm"
     },
     "conversion_reason": {
      "type": "string",
      "title": "Reason for conversion",
      "x-widget": "textarea",
      "x-section": "Conversion"
     },
     "remarks": {
      "type": "string",
      "title": "Anything the office should know",
      "x-widget": "textarea",
      "x-section": "Other"
     }
    },
    "x-order": [
     "property",
     "property_id",
     "zone",
     "address",
     "land_use",
     "area_sqm",
     "conversion_reason",
     "remarks"
    ]
   },
   "fee_ref": "urban.fee_schedule",
   "sla_ref": "scrutiny 72h, approval 48h"
  }
 },
